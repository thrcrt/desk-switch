#!/usr/bin/env bash
# dw — flip a DDC-capable monitor between two or more Macs sharing it.
# Requires: m1ddc, jq (brew install m1ddc jq)

set -euo pipefail

# Make sure brew-managed deps are findable when invoked from Raycast or any
# other launcher that strips PATH.
export PATH="/opt/homebrew/bin:$HOME/bin:$HOME/.local/bin:$PATH"

VERSION="0.3.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dw"
CONFIG_FILE="$CONFIG_DIR/config.json"

err()  { printf 'dw: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }
info() { printf '%s\n' "$*"; }
ok()   { printf '✓ %s\n' "$*"; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 (try: brew install $1)"
}

require_cmd m1ddc
require_cmd jq

is_int() { [[ "$1" =~ ^[0-9]+$ ]]; }
is_name() { [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]; }

config_exists() { [ -f "$CONFIG_FILE" ]; }

read_config() {
  config_exists || die "no config at $CONFIG_FILE — run 'dw init' first"
  jq -e . "$CONFIG_FILE" >/dev/null 2>&1 || die "config at $CONFIG_FILE is not valid JSON"
}

get_cfg() { jq -r "$1" "$CONFIG_FILE"; }

device_names() { get_cfg '.devices | keys_unsorted[]'; }
device_count() { jq '.devices | length' "$CONFIG_FILE"; }
this_device()  { get_cfg '.this_device'; }
input_for()    { jq -r --arg n "$1" '.devices[$n].input // empty' "$CONFIG_FILE"; }
display_sel()  { get_cfg '.display.selector'; }

has_device() { [ -n "$(input_for "$1")" ]; }

write_cfg_jq() {
  local filter="$1"
  local tmp; tmp=$(mktemp)
  jq "$filter" "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
}

list_displays() { m1ddc display list 2>&1; }

do_switch() {
  local sel="$1" code="$2" label="$3"
  is_int "$code" || die "input code '$code' is not numeric"
  info "Switching display '$sel' → '$label' (VCP 0x60 = $code)..."
  if ! m1ddc display "$sel" set input "$code"; then
    die "m1ddc could not write input. Verify selector '$sel' (try 'dw list') and that the monitor supports DDC input switching."
  fi
}

prompt_default() {
  local prompt="$1" default="$2" reply=""
  if [ -t 0 ]; then read -r -p "$prompt [$default]: " reply || true; fi
  printf '%s\n' "${reply:-$default}"
}

prompt_yes() {
  local prompt="$1" reply=""
  if [ -t 0 ]; then read -r -p "$prompt [Y/n] " reply || true; fi
  case "${reply:-y}" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

print_input_codes() {
  cat <<'EOF'
  Common VCP 0x60 input codes:
    15  DisplayPort 1
    16  DisplayPort 2
    17  HDMI 1
    18  HDMI 2
    27  USB-C
EOF
}

repo_dir() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local target; target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
    esac
  done
  cd "$(dirname "$src")/.." && pwd
}

origin_slug() {
  local rd origin slug
  rd="$(repo_dir 2>/dev/null || true)"
  if [ -n "$rd" ] && [ -d "$rd/.git" ]; then
    origin="$(cd "$rd" && git remote get-url origin 2>/dev/null || true)"
  fi
  case "$origin" in
    git@github.com:*)     slug="${origin#git@github.com:}"; slug="${slug%.git}" ;;
    https://github.com/*) slug="${origin#https://github.com/}"; slug="${slug%.git}" ;;
    *)                    slug="thrcrt/desk-switch" ;;
  esac
  printf '%s\n' "$slug"
}

bootstrap_url() {
  printf 'https://raw.githubusercontent.com/%s/main/bootstrap.sh\n' "$(origin_slug)"
}

cmd_init() {
  info "dw init — set up devices on this Mac."
  info ""
  info "Displays detected by m1ddc:"
  list_displays | sed 's/^/  /'
  info ""

  local display_n
  display_n=$(prompt_default "Which display number to control?" "1")
  is_int "$display_n" || die "display number must be numeric"

  if ! prompt_yes "Is the monitor currently displaying THIS Mac?"; then
    die "Switch the monitor to THIS Mac (with its joystick/OSD), then re-run init."
  fi

  info ""
  print_input_codes
  info ""

  local n_devices
  n_devices=$(prompt_default "How many devices share this monitor?" "2")
  is_int "$n_devices" || die "device count must be numeric"
  [ "$n_devices" -ge 2 ] || die "at least 2 devices required"

  local devices_json='{}' i name code
  for ((i=1; i<=n_devices; i++)); do
    info ""
    info "Device $i of $n_devices:"
    name=$(prompt_default "  Name (no spaces)" "device-$i")
    is_name "$name" || die "name '$name' contains invalid characters (allowed: letters, digits, . _ -)"
    code=$(prompt_default "  VCP input code" "27")
    is_int "$code"  || die "input code must be numeric"
    devices_json=$(printf '%s' "$devices_json" \
      | jq --arg n "$name" --argjson c "$code" '. + {($n): {input: $c}}')
  done

  info ""
  info "Configured devices:"
  printf '%s' "$devices_json" | jq -r 'to_entries[] | "  \(.key) → input \(.value.input)"'
  info ""
  local first_name
  first_name=$(printf '%s' "$devices_json" | jq -r 'keys_unsorted[0]')
  local this_device_name
  this_device_name=$(prompt_default "Which one is THIS Mac?" "$first_name")
  printf '%s' "$devices_json" | jq -e --arg n "$this_device_name" '.[$n]' >/dev/null \
    || die "'$this_device_name' is not in the device list"

  mkdir -p "$CONFIG_DIR"
  local tmp; tmp=$(mktemp)
  jq -n \
    --argjson v 2 \
    --arg    dsel "$display_n" \
    --arg    this "$this_device_name" \
    --argjson devs "$devices_json" \
    '{version: $v, display: {selector: $dsel}, this_device: $this, devices: $devs}' \
    > "$tmp"
  mv "$tmp" "$CONFIG_FILE"

  info ""
  ok "Wrote $CONFIG_FILE"
  info ""
  info "Try:"
  info "  dw status"
  info "  dw list"
  for n in $(device_names); do
    [ "$n" = "$this_device_name" ] && continue
    info "  dw $n"
  done
  info "  dw setup raycast       # generate per-device commands and add to Raycast"
  info "  dw share               # one-paste install commands for the other devices"
}

cmd_status() {
  read_config
  info "Display selector: $(display_sel)"
  info "This device:      $(this_device)"
  info ""
  info "Devices:"
  jq -r '.devices | to_entries[] | "  \(.key)\t→ input \(.value.input)"' "$CONFIG_FILE" \
    | column -t -s "$(printf '\t')"
}

cmd_list() {
  info "Connected displays (m1ddc):"
  list_displays
  info ""
  if config_exists; then
    info "Config: $CONFIG_FILE"
    info "  display selector: $(display_sel)"
    info "  this device:      $(this_device)"
    info "  devices:"
    local td; td="$(this_device)"
    while IFS= read -r n; do
      local code; code="$(input_for "$n")"
      if [ "$n" = "$td" ]; then
        info "    * $n  (input $code)  [this Mac]"
      else
        info "      $n  (input $code)"
      fi
    done < <(device_names)
  else
    info "(no config — run 'dw init')"
  fi
}

cmd_switch_to() {
  read_config
  local target="$1"
  has_device "$target" || die "unknown device '$target'. Configured: $(device_names | tr '\n' ' ')"
  do_switch "$(display_sel)" "$(input_for "$target")" "$target"
}

cmd_toggle() {
  read_config
  local n; n=$(device_count)
  if [ "$n" -eq 2 ]; then
    local td; td="$(this_device)"
    local other; other="$(device_names | grep -v "^${td}$" | head -1)"
    do_switch "$(display_sel)" "$(input_for "$other")" "$other"
  else
    info "$n devices configured. With 3 or more, 'dw' alone won't toggle."
    info "Run an explicit switch:"
    local td; td="$(this_device)"
    while IFS= read -r name; do
      [ "$name" = "$td" ] && continue
      info "  dw $name"
    done < <(device_names)
    exit 2
  fi
}

cmd_add() {
  read_config
  local name="${1:-}" code="${2:-}"
  [ -n "$name" ] || die "usage: dw add <name> <input-code>"
  [ -n "$code" ] || die "usage: dw add <name> <input-code>"
  is_name "$name" || die "invalid name '$name'"
  is_int  "$code" || die "input code must be numeric"
  has_device "$name" && die "device '$name' already exists. Use 'dw remove $name' first."
  write_cfg_jq ".devices += {\"$name\": {input: $code}}"
  ok "Added device '$name' (input $code)"
  cmd_list
}

cmd_remove() {
  read_config
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dw remove <name>"
  has_device "$name" || die "no device named '$name'"
  [ "$name" = "$(this_device)" ] && die "cannot remove the current 'this device' ($name). Use 'dw use <other>' first."
  write_cfg_jq "del(.devices[\"$name\"])"
  ok "Removed device '$name'"
  cmd_list
}

cmd_use() {
  read_config
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dw use <name>"
  has_device "$name" || die "no device named '$name'"
  write_cfg_jq ".this_device = \"$name\""
  ok "this_device → $name"
}

cmd_reset() {
  local yes=0
  case "${1:-}" in --yes|-y) yes=1 ;; esac

  local config_present=0 raycast_present=0
  [ -d "$CONFIG_DIR" ]  && config_present=1
  [ -d "$RAYCAST_DIR" ] && raycast_present=1

  if [ "$config_present" -eq 0 ] && [ "$raycast_present" -eq 0 ]; then
    info "Nothing to reset."
    return 0
  fi

  info "dw reset will remove:"
  [ "$config_present" -eq 1 ]  && info "  - config:                $CONFIG_DIR"
  [ "$raycast_present" -eq 1 ] && info "  - generated Raycast dir: $RAYCAST_DIR"
  info ""
  info "It will NOT touch:"
  info "  - the dw binary or its symlink (use ./uninstall.sh for that)"
  info "  - Homebrew deps (m1ddc, jq)"
  info "  - the Raycast 'Add Script Directory' entry inside Raycast Settings"
  info ""

  if [ "$yes" -ne 1 ]; then
    local reply=""
    if [ -t 0 ]; then read -r -p "Continue? [y/N] " reply || true; fi
    case "${reply:-n}" in
      y|Y|yes|YES|Yes) ;;
      *) info "Aborted."; return 0 ;;
    esac
  fi

  if [ "$config_present" -eq 1 ]; then
    rm -rf "$CONFIG_DIR"
    ok "removed $CONFIG_DIR"
  fi
  if [ "$raycast_present" -eq 1 ]; then
    rm -rf "$RAYCAST_DIR"
    rmdir "$DW_DOCS_DIR" 2>/dev/null || true
    ok "removed $RAYCAST_DIR"
  fi

  info ""
  info "Done. To start fresh:"
  info "  dw init                              # full wizard on this Mac"
  info "  # or paste the matching 'dw share' line from another Mac"
}

cmd_share() {
  read_config
  local td bs_url devices_arg
  td="$(this_device)"
  bs_url="$(bootstrap_url)"
  devices_arg=$(jq -r '.devices | to_entries | map("\(.key)=\(.value.input)") | join(",")' "$CONFIG_FILE")

  info "Paste-and-run install commands for each OTHER device."
  info "Each command clones the repo, installs deps, and writes the device's"
  info "config. After it finishes, the device is ready to use immediately."
  info ""
  while IFS= read -r name; do
    [ "$name" = "$td" ] && continue
    info "## On '$name':"
    info ""
    info "  bash <(curl -fsSL $bs_url) --this $name --devices \"$devices_arg\""
    info ""
  done < <(device_names)
}

# Lives under ~/Documents/ so the directory is visible to Finder; Raycast's
# "Add Script Directory" picker can't navigate to ~/.config (hidden).
DW_DOCS_DIR="$HOME/Documents/dw"
RAYCAST_DIR="$DW_DOCS_DIR/raycast"

# Bash 3.2 compatible (no ${var^}).
capitalize() {
  local s="$1" first rest
  first=$(printf '%s' "$s" | head -c 1 | tr '[:lower:]' '[:upper:]')
  rest=$(printf '%s' "$s" | tail -c +2)
  printf '%s%s' "$first" "$rest"
}

generate_raycast_scripts() {
  read_config
  rm -rf "$RAYCAST_DIR"
  mkdir -p "$RAYCAST_DIR"
  local td name code display
  td="$(this_device)"
  while IFS= read -r name; do
    [ "$name" = "$td" ] && continue
    code="$(input_for "$name")"
    display="$(capitalize "$name")"
    cat > "$RAYCAST_DIR/dw-$name.sh" <<EOF
#!/usr/bin/env bash
# @raycast.schemaVersion 1
# @raycast.title dw → $display
# @raycast.mode silent
# @raycast.icon 🖥
# @raycast.packageName Desk Switch
# @raycast.description VCP input $code on the configured display.

export PATH="/opt/homebrew/bin:\$HOME/bin:\$HOME/.local/bin:\$PATH"
exec dw "$name"
EOF
    chmod +x "$RAYCAST_DIR/dw-$name.sh"
  done < <(device_names)
}

setup_raycast() {
  if [ ! -d /Applications/Raycast.app ]; then
    die "Raycast not found. Install (raycast.com or 'brew install --cask raycast') and re-run."
  fi
  read_config

  generate_raycast_scripts
  local count
  count="$(ls "$RAYCAST_DIR" 2>/dev/null | wc -l | tr -d ' ')"
  ok "Generated $count Raycast script command(s) in:"
  info "  $RAYCAST_DIR"
  info ""
  info "Commands generated:"
  for f in "$RAYCAST_DIR"/*.sh; do
    [ -e "$f" ] || break
    local title
    title="$(grep '@raycast.title' "$f" | sed 's/.*@raycast.title //')"
    info "  🖥   $title"
  done
  info ""

  info "FIRST-TIME SETUP (only needed once on this Mac):"
  info "  1. Raycast Settings (⌘,) → Extensions → Script Commands"
  info "  2. Click '+' → Add Script Directory"
  info "  3. In the file picker, navigate to:  Documents → dw → raycast"
  info "       (full path: $RAYCAST_DIR)"
  info "  4. Click 'Open'"
  info ""
  info "After that, every 'dw setup raycast' regenerates the scripts here"
  info "and Raycast picks up the changes automatically — no more clicking."
  info ""
  info "Type 'dw' in Raycast → autocomplete will list every device."
  open "raycast://"
}

cmd_setup() {
  local target="${1:-}"
  case "$target" in
    raycast) setup_raycast ;;
    ""|menu)
      if [ -d /Applications/Raycast.app ]; then
        info "Raycast detected. Run: dw setup raycast"
      else
        info "Raycast not detected. Install raycast.com or 'brew install --cask raycast'."
      fi
      ;;
    *) die "unknown setup target: $target. Try: raycast" ;;
  esac
}

cmd_help() {
  cat <<EOF
dw v$VERSION — flip a DDC-capable monitor between two or more Macs.

USAGE
  dw                        Toggle (2 devices) or list (3+ devices).
  dw <device>               Switch monitor to <device> by name.
  dw init                   Configure devices on THIS Mac (interactive).
  dw add <name> <input>     Append a new device to the config.
  dw remove <name>          Remove a device.
  dw use <name>             Change which device THIS Mac is.
  dw share                  Print paste-and-run install commands for other Macs.
  dw setup raycast          Generate per-device commands and wire into Raycast.
  dw reset [--yes]          Wipe config + generated Raycast bindings (keeps
                              binary, symlink, brew deps).
  dw list                   List displays + show config.
  dw status                 Show current config.
  dw help                   This message.

CONFIG
  $CONFIG_FILE

DEPENDENCIES
  m1ddc, jq    (brew install m1ddc jq)
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ""|toggle)         cmd_toggle ;;
    init)              cmd_init ;;
    add)               shift || true; cmd_add    "${1:-}" "${2:-}" ;;
    remove|rm)         shift || true; cmd_remove "${1:-}" ;;
    use)               shift || true; cmd_use    "${1:-}" ;;
    share)             cmd_share ;;
    setup)             shift || true; cmd_setup  "${1:-}" ;;
    reset)             shift || true; cmd_reset  "${1:-}" ;;
    status)            cmd_status ;;
    list|ls)           cmd_list ;;
    -h|--help|help)    cmd_help ;;
    -v|--version)      printf '%s\n' "$VERSION" ;;
    *)                 cmd_switch_to "$cmd" ;;
  esac
}

main "$@"
